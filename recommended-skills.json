{
  "version": 1,
  "skills": [
    {
      "name": "skill-creator",
      "title": "Skill Creator",
      "category": "engineering",
      "description": "Anthropic 官方技能创作工具，从零创建、修改、评测一个 skill，或优化 description 以提升触发准确率。",
      "source": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/skill-creator",
      "install": {
        "method": "plugin",
        "marketplace": "anthropics/claude-plugins-official",
        "plugin": "skill-creator",
        "command": "claude plugin install skill-creator@claude-plugins-official"
      },
      "usage": "当要创建新 skill、改进现有 skill，或跑评测 / 优化触发词时使用。",
      "notes": "示例条目，可替换为任意真实第三方 skill。"
    },
    {
      "name": "pdf",
      "title": "PDF",
      "category": "engineering",
      "description": "Anthropic 官方 PDF 技能，读写、分析、转换 PDF 文档。",
      "source": "https://github.com/anthropics/skills",
      "homepage": "https://github.com/anthropics/skills/tree/main/skills/pdf",
      "install": {
        "method": "git",
        "repo": "https://github.com/anthropics/skills",
        "path": "skills/pdf",
        "command": "mkdir -p ~/.claude/skills && git clone --depth 1 https://github.com/anthropics/skills ~/anthropics-skills && ln -s ~/anthropics-skills/skills/pdf ~/.claude/skills/pdf"
      },
      "usage": "处理 PDF 文档（读取、生成、提取、转换）时使用。",
      "notes": "示例条目，可替换为任意真实第三方 skill。"
    }
  ]
}
